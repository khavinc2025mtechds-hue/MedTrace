# Defaults work with bundled public records and extractive regulatory retrieval.
DATABASE_URL=sqlite:///data/medtrace.db
RETRIEVAL_BACKEND=tfidf
WORKFLOW_BACKEND=sequential
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENFDA_API_KEY=
# Streamlit uses in-process services by default. Optional separate backend:
MEDTRACE_API_URL=
# Optional PostgreSQL: postgresql+psycopg://medtrace:password@localhost:5432/medtrace
POSTGRES_PASSWORD=
CLASSIFIER_BACKEND=rules
